# Bridge 服务配置
# 复制此文件为 .env，填入实际值

# 监听端口（默认 17777）
LOCAL_AI_PORT=17777

# 本地鉴权 Token（留空则跳过鉴权，仅在开发时留空）
LOCAL_AI_TOKEN=

# 默认 provider（gemini、deepseek 或 codex）
DEFAULT_PROVIDER=gemini

# Gemini MCP 服务入口（默认使用本机统一的 gemini-agent-mcp）
GEMINI_MCP_SERVER_PATH=C:\Users\hang\mcp-servers\gemini-agent-mcp\dist\index.js

# 传给 Gemini MCP 的 prompt 最大长度。0 表示不在 bridge 截断，由 Gemini MCP 临时文件机制处理长文本。
GEMINI_MCP_MAX_PROMPT_CHARS=0

# Gemini 模型（由 Gemini MCP / Gemini CLI 处理）
# 无需配置 API Key，自动读取 Gemini CLI 的 OAuth 凭证（~/.gemini/oauth_creds.json）
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek API（provider=deepseek 时使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=60000

# CLI 路径（codex provider 仍用 CLI 方式）
CODEX_CMD=codex

# AI 调用超时时间（毫秒）
CLI_TIMEOUT_MS=30000

# Google Docs 导出 Webhook（Google Apps Script Web App URL）
GOOGLE_DOCS_WEBHOOK_URL=

# Google Docs 导出 Webhook 密钥。需要和 Apps Script Script Properties 里的 WEBHOOK_SECRET 一致。
GOOGLE_DOCS_WEBHOOK_SECRET=

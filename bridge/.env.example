# Bridge 服务配置
# 复制此文件为 .env，填入实际值

# 监听端口（默认 17777）
LOCAL_AI_PORT=17777

# PageMind 内测接口 Token。前端请求头 X-PageMind-Beta-Token 必须与此值一致。
PAGEMIND_BETA_TOKEN=你的内测token

# Gemini 网页分析 MCP 入口。留空时默认使用本项目内置的 bridge/mcp/gemini-web-agent.js
GEMINI_MCP_SERVER_PATH=./mcp/gemini-web-agent.js
GEMINI_MCP_ASSET_DIR=./assets/gemini
GEMINI_CMD=gemini

# DeepSeek API（provider=deepseek 时使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_MS=60000

# CLI 路径（codex provider 仍用 CLI 方式）
CODEX_CMD=codex

# AI 调用超时时间（毫秒）
CLI_TIMEOUT_MS=30000

# Google Docs 导出 Webhook（Google Apps Script Web App URL）
GOOGLE_DOCS_WEBHOOK_URL=

# Google Docs 导出 Webhook 密钥。需要和 Apps Script Script Properties 里的 WEBHOOK_SECRET 一致。
GOOGLE_DOCS_WEBHOOK_SECRET=
